{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "server",
    "outDir": "server/build",
    "noEmit": false
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/build"]
}
