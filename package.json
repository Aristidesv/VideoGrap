{
  "name": "@workspace/yt-downloader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --config vite.config.ts --host 0.0.0.0\"",
    "build": "npm run typecheck && npm run build:server && vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server/build/index.js",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
